# --- Secrets & local user data (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
token*
*token*.txt
*credentials*

# App data is stored under the user home directory, not this repo:
#   %USERPROFILE%\.discord_channel_backup\   (Windows)
#   ~/.discord_channel_backup/               (macOS/Linux)
# Still ignore if someone copies it here by mistake:
.discord_channel_backup/
bots.enc.json
bots.json
.settings.json

